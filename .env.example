# Copy this to .env on the server and fill it in.

# The address people will use. Point its DNS at this server first.
AEP_DOMAIN=aep.yourdomain.com

# Lets the first person sign up. Make one with: openssl rand -hex 24
AEP_SIGNUP_CODE=

# A real contact address, sent with phone alerts. Push services can reject placeholders.
AEP_VAPID_SUBJECT=mailto:you@yourdomain.com
